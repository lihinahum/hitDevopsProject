      "target": "1552x840",
      "targets": [],
      "value": ""
    }, {
      "id": "40bb1b77-6e8f-4a4a-a3a5-8b9791c0d790",
      "comment": "",
      "command": "click",
      "target": "name=task",
      "targets": [
        ["name=task", "name"],
        ["css=input", "css:finder"],
        ["xpath=//input[@name='task']", "xpath:attributes"],
        ["xpath=//input", "xpath:position"]
      ],
      "value": ""
    }, {
      "id": "bfc089a5-55de-465f-8d8f-85e77f851093",
      "comment": "",
