        ["linkText=Clear All Tasks", "linkText"],
        ["css=p > a", "css:finder"],
        ["xpath=//a[contains(text(),'Clear All Tasks')]", "xpath:link"],
        ["xpath=//a[contains(@href, 'index.jsp?clear=true')]", "xpath:href"],
        ["xpath=//p/a", "xpath:position"],
        ["xpath=//a[contains(.,'Clear All Tasks')]", "xpath:innerText"]
      ],
      "value": ""
    }, {
      "id": "7e1bc0f6-4e42-4c98-866b-3fffbf402a69",
      "comment": "",
