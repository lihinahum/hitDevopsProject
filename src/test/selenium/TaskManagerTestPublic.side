        ["linkText=Complete", "linkText"],
        ["css=.toggle-btn", "css:finder"],
        ["xpath=//a[contains(text(),'Complete')]", "xpath:link"],
        ["xpath=//a[contains(@href, 'index.jsp?toggle=0')]", "xpath:href"],
        ["xpath=//a", "xpath:position"],
        ["xpath=//a[contains(.,'Complete')]", "xpath:innerText"]
      ],
      "value": ""
    }, {
